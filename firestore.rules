rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The public site can add a narrowly validated subscription request. It
    // cannot list, read, edit, or delete any subscriber document.
    match /subscribers/{subscriberId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'email',
          'source',
          'status',
          'timestamp'
        ]) &&
        request.resource.data.email is string &&
        request.resource.data.email.size() >= 3 &&
        request.resource.data.email.size() <= 254 &&
        request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$') &&
        request.resource.data.source in ['blog', 'footer'] &&
        request.resource.data.status == 'subscribed' &&
        request.resource.data.timestamp == request.time;

      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
